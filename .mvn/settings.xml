<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!--
    Route all Maven Central traffic through IBM Artifactory.
    Credentials are supplied via ARTIFACTORY_USER / ARTIFACTORY_TOKEN
    environment variables (set as GitHub Actions secrets).
  -->
  <mirrors>
    <mirror>
      <id>ibm-artifactory</id>
      <name>IBM Artifactory Maven Central Mirror</name>
      <url>https://na.artifactory.swg-devops.com:443/artifactory/wasliberty-maven-remote</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <servers>
    <server>
      <id>ibm-artifactory</id>
      <username>${env.ARTIFACTORY_USER}</username>
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>artifactory</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>ibm-artifactory</id>
          <name>IBM Artifactory Maven Central Mirror</name>
          <url>https://na.artifactory.swg-devops.com:443/artifactory/wasliberty-maven-remote</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>ibm-artifactory</id>
          <name>IBM Artifactory Maven Central Mirror</name>
          <url>https://na.artifactory.swg-devops.com:443/artifactory/wasliberty-maven-remote</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

</settings>
